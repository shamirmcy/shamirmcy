# Copy to .env for local development. Production refuses to boot with dev defaults.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://kmdoch:kmdoch@localhost:5432/kmdoch
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:3000

# Secrets (generate: openssl rand -base64 48 ; DATA_ENCRYPTION_KEY: openssl rand -base64 32)
JWT_SECRET=
QUOTE_SECRET=
OTP_PEPPER=
DATA_ENCRYPTION_KEY=
PAYMENT_WEBHOOK_SECRET=

# Adapters
SMS_PROVIDER=console          # console | msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
PUSH_PROVIDER=console         # console | fcm
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
PAYMENT_GATEWAY=fake          # fake | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MAPS_PROVIDER=offline            # offline | google (Routes API for ETA, Places + Geocoding for address search)
MAPS_TRAVEL_MODE=DRIVE           # DRIVE | TWO_WHEELER
GOOGLE_MAPS_API_KEY=             # server-side key; enable Routes API, Places API (New), Geocoding API
WHATSAPP_PROVIDER=console        # console | meta | off (SMS only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=kmdoch_otp # approved authentication template (en, ta, kn, hi)
WHATSAPP_APP_SECRET=             # verifies delivery-status webhooks
WHATSAPP_VERIFY_TOKEN=           # any string; also entered in Meta's webhook settings
DEV_TOOLS=true                   # /dev test page and /docs (never available in production)
STORAGE_DRIVER=local          # local | s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=

# Business
OPS_ADMIN_PHONES=+919000000001      # comma-separated; these phones get ops_admin on first ops sign-in
PARTNER_DESK_PHONE=+910000000000    # OPEN ITEM: real number from the business
INLINE_JOBS=false                   # true = run jobs in the API process (dev only)
LOG_LEVEL=info
