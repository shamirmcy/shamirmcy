{
  "name": "km-doch-backend",
  "version": "0.1.0",
  "description": "KM DocH (Doctor At Your Home) backend API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts",
    "migrate:prod": "node dist/db/migrate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shamirmcy/shamirmcy.git"
  },
  "bugs": {
    "url": "https://github.com/shamirmcy/shamirmcy/issues"
  },
  "homepage": "https://github.com/shamirmcy/shamirmcy#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/websocket": "^11.3.1",
    "bullmq": "^6.3.11",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
